{
  "name": "reflow",
  "productName": "Reflow",
  "version": "1.1.1",
  "description": "把散落在各电商平台的订单数据归集到你自己手上",
  "main": "./out/main/index.js",
  "author": {
    "name": "FaustDream",
    "email": "FaustDream@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaustDream/Reflow.git"
  },
  "homepage": "https://github.com/FaustDream/Reflow#readme",
  "bugs": {
    "url": "https://github.com/FaustDream/Reflow/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "electron-vite dev -- --web",
    "dev:web:sw": "electron-vite dev -- --web --no-sandbox --disable-gpu --disable-gpu-sandbox --use-gl=swiftshader --use-angle=swiftshader",
    "dev:web:demo": "node scripts/dev-demo.mjs --web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:preload && npm run typecheck:web",
    "test": "vitest run",
    "icon": "node scripts/make-icon.cjs",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
