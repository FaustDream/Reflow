# 依赖与构建产物（electron-vite 只产出 out/，electron-builder 落到 dist-*/）
node_modules/
out/
dist-*/

# 工具缓存 / 覆盖率输出；*.tsbuildinfo、.vite 落在 node_modules/ 下，已由上级覆盖
.cache/
coverage/

# unplugin 自动生成的声明（手写的 env.d.ts 必须入库）
src/renderer/src/components.d.ts
src/renderer/src/auto-imports.d.ts

# 日志与自检脚本产物
*.log
logs/
.scratch/
AGENTS.md
.workbuddy/

# 本地环境与凭据
.env*
!.env.example
*.local*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# 编辑器与系统临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.sw[po]
*~
*.tmp
*.bak
*.orig

# 真实数据与导出表格；testdata/*.json 为脱敏 fixture，必须入库
testdata/**/*.real.*
*.xls*

# 本地工单与逆向分析文档：整目录不入库（README 截图已移至 assets/screenshots/）
/docs/
.tmp-dist/
